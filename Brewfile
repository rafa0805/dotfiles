# macOS / Ubuntu 共通で入れる CLI ツール

brew "bat"       # シンタックスハイライト付きcat
brew "eza"       # 見やすいls（アイコン・git状態表示）
brew "fd"        # 速くて使いやすいfind
brew "fzf"       # あいまい検索（Ctrl-R で履歴検索）
brew "gh"        # GitHub CLI（PR・issue操作）
brew "git"       # バージョン管理
brew "git-delta" # delta: git差分を綺麗に表示
brew "herdr"     # ターミナルで動くエージェント用マルチプレクサ
brew "jq"        # JSON処理
brew "lazygit"   # gitのTUIクライアント
brew "mise"      # 言語ランタイムのバージョン管理
brew "ripgrep"   # rg: 速い grep
brew "smug"      # tmuxセッションをYAMLで定義・起動
brew "starship"  # 軽量でカスタマイズしやすいシェルプロンプト
brew "tmux"      # ターミナルマルチプレクサ
brew "tree"      # ディレクトリ構造をツリー表示
brew "zoxide"    # z: よく使うディレクトリへ素早く移動

# macOS だけで入れたいもの
if OS.mac?
  # cask "iterm2"
end
